# PostgreSQL connection (Neon, local Postgres, etc.)
# Production (Neon): use your Neon connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fitness_challenge?sslmode=require"

# Local Prisma dev (after `npm run db:dev`):
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# App URL (local dev)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
