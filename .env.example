# PostgreSQL connection (Neon recommended)
#
# Pooled URL (for Vercel + local app — uses Neon serverless driver in code):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
#
# If `npx prisma db push` fails with P1001 on your network (port 5432 blocked),
# use:  npm run db:production-setup
# That script auto-falls back to Neon HTTPS when TCP is blocked.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"

# App URL (local dev)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Admin broadcast email (Gmail SMTP)
ADMIN_FROM_EMAIL="alkalinetransform@gmail.com"
GMAIL_USER="alkalinetransform@gmail.com"
# App password from Google Account → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD="your-16-char-app-password"
