generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PLAYER
}

enum GymStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GymEndPhase {
  NONE
  AWAITING_METRICS
  RESULTS_RELEASED
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String
  name                    String
  role                    Role
  gymId                   String?
  gym                     Gym?      @relation("GymPlayers", fields: [gymId], references: [id])
  ownedGym                Gym?      @relation("GymAdmin")
  emailVerified           Boolean   @default(false)
  emailVerifyToken        String?   @unique
  emailVerifyExpires      DateTime?
  isFrozen                Boolean   @default(false)
  welcomeSeenAt           DateTime?
  profileSetupComplete    Boolean   @default(false)
  stepsPerDay             Int?
  waterOzPerDay           Int?
  startSkeletalMuscleMass Float?
  startWeightLbs          Float?
  startBodyFatPercent     Float?
  endSkeletalMuscleMass   Float?
  endWeightLbs            Float?
  endBodyFatPercent       Float?
  endBoneMass             Float?
  endMuscleMass           Float?
  endMetricsSentAt        DateTime?
  resultsWrapSeenAt       DateTime?
  completions             Completion[]
  teamMembers             TeamMember[]
  messageDismissals       MessageDismissal[]
  broadcastTargets        BroadcastMessageTarget[]
  endMetricsDrafts        PlayerEndMetricsDraft[]
  createdAt               DateTime  @default(now())
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  maxUses   Int       @default(10)
  usedCount Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Gym {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  location        String
  adminId         String              @unique
  admin           User                @relation("GymAdmin", fields: [adminId], references: [id])
  status          GymStatus           @default(PENDING)
  activeWeek      Int                 @default(1)
  seasonStartDate DateTime            @default(now())
  competitionName String              @default("Transformation Challenge")
  challengeEnded  Boolean             @default(false)
  endedAt         DateTime?
  endPhase        GymEndPhase         @default(NONE)
  players         User[]              @relation("GymPlayers")
  challenges      Challenge[]
  teams           Team[]
  messages        BroadcastMessage[]
  archives        CompetitionArchive[]
  endMetricsDrafts PlayerEndMetricsDraft[]
  createdAt       DateTime            @default(now())
}

model BroadcastMessage {
  id             String                   @id @default(cuid())
  gymId          String
  gym            Gym                      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  body           String
  sendToEmail    Boolean                  @default(false)
  sendToInApp    Boolean                  @default(true)
  isBroadcastAll Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  dismissals     MessageDismissal[]
  targets        BroadcastMessageTarget[]
}

model BroadcastMessageTarget {
  messageId String
  userId    String
  message   BroadcastMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model MessageDismissal {
  userId      String
  messageId   String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     BroadcastMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  dismissedAt DateTime         @default(now())

  @@id([userId, messageId])
}

model CompetitionArchive {
  id           String   @id @default(cuid())
  gymId        String
  gym          Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name         String
  endedAt      DateTime
  snapshotJson String
  createdAt    DateTime @default(now())
}

model PlayerEndMetricsDraft {
  userId              String
  gymId               String
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym                 Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  skeletalMuscleMass  Float?
  weightLbs           Float?
  bodyFatPercent      Float?
  boneMass            Float?
  muscleMass          Float?
  updatedAt           DateTime @updatedAt

  @@id([userId, gymId])
}

model Challenge {
  id            String       @id @default(cuid())
  gymId         String
  gym           Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  weekNumber    Int
  name          String
  description   String
  points        Int
  startDate     DateTime     @default(now())
  durationDays  Int          @default(7) @map("durationWeeks")
  expiresAt     DateTime
  completions   Completion[]
  createdAt     DateTime     @default(now())

  @@index([gymId, weekNumber])
  @@index([gymId, expiresAt])
}

model Team {
  id      String       @id @default(cuid())
  gymId   String
  gym     Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name    String
  icon    String       @default("🍊")
  members TeamMember[]
}

model TeamMember {
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Completion {
  userId      String
  challengeId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  completedAt DateTime  @default(now())

  @@id([userId, challengeId])
}
